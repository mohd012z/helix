{
  "name": "HELIX lightweight Codespaces",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --disable-pip-version-check -r requirements.txt",
  "remoteUser": "vscode"
}
